<%- include('../partials/head') %>

<div class="auth-container">
    <div class="auth-card">
        <div class="auth-header">
            <i data-lucide="wallet" class="brand-icon-lg text-primary"></i>
            <h2>Bem-vindo de volta</h2>
            <p>Acesse o MoneyFinance para gerenciar as finanças.</p>
        </div>
        
        <form action="/login" method="POST" class="auth-form">
            <div class="form-group">
                <label for="email">E-mail</label>
                <div class="input-with-icon">
                    <i data-lucide="mail"></i>
                    <input type="email" id="email" name="email" required placeholder="seu@email.com">
                </div>
            </div>
            
            <div class="form-group">
                <label for="password">Senha</label>
                <div class="input-with-icon">
                    <i data-lucide="lock"></i>
                    <input type="password" id="password" name="password" required placeholder="••••••••">
                </div>
            </div>
            
            <button type="submit" class="btn btn-primary btn-block mt-4">Entrar</button>
        </form>
        
        <div class="auth-footer">
            <p>Novo por aqui? <a href="/register">Crie uma conta</a></p>
        </div>
    </div>
</div>

<%- include('../partials/tail') %>
