<%- include('../partials/head') %>

<div class="card glass-card max-w-2xl mx-auto">
    <div class="card-header">
        <h2>Configurações de Divisão</h2>
        <p class="text-muted">Ajuste as porcentagens para a divisão dos lucros da empresa. A soma deve ser exatamente 100%.</p>
    </div>
    <div class="card-body">
        <form action="/settings" method="POST" class="std-form">
            
            <div class="form-group">
                <label for="company_pct">Fundo da Empresa (%)</label>
                <div class="input-with-icon">
                    <i data-lucide="building"></i>
                    <input type="number" id="company_pct" name="company_pct" step="0.1" min="0" max="100" required 
                           value="<%= settings.company_pct %>">
                </div>
            </div>

            <div class="form-group">
                <label for="ortiz_pct">Parte do Ortiz (%)</label>
                <div class="input-with-icon">
                    <i data-lucide="user"></i>
                    <input type="number" id="ortiz_pct" name="ortiz_pct" step="0.1" min="0" max="100" required 
                           value="<%= settings.ortiz_pct %>">
                </div>
            </div>

            <div class="form-group">
                <label for="davi_pct">Parte do Davi (%)</label>
                <div class="input-with-icon">
                    <i data-lucide="user"></i>
                    <input type="number" id="davi_pct" name="davi_pct" step="0.1" min="0" max="100" required 
                           value="<%= settings.davi_pct %>">
                </div>
            </div>

            <div class="form-actions mt-6">
                <button type="submit" class="btn btn-primary">
                    <i data-lucide="save"></i> Salvar Configurações
                </button>
            </div>
        </form>
    </div>
</div>

<div class="card glass-card max-w-2xl mx-auto mt-6">
    <div class="card-body" style="display: flex; align-items: center; justify-content: space-between;">
        <div style="display: flex; align-items: center; gap: 1rem;">
            <div style="background: rgba(255,255,255,0.05); padding: 12px; border-radius: 12px;">
                <i data-lucide="bell" style="width: 24px; height: 24px; color: #fff;"></i>
            </div>
            <div>
                <h3 style="margin: 0; font-size: 1.1rem; color: #fff; font-weight: 500;">Notificações Push</h3>
                <p class="text-muted" style="margin: 0; font-size: 0.9rem;">Ative para receber alertas</p>
            </div>
        </div>
        <div>
            <label class="switch">
                <input type="checkbox" id="pushToggle" disabled>
                <span class="slider round"></span>
            </label>
        </div>
    </div>
</div>

<script>
    // Pass public key from env to frontend
    window.VAPID_PUBLIC_KEY = "<%= process.env.VAPID_PUBLIC_KEY %>";
</script>
<script src="/js/push.js"></script>

<style>
/* CSS for the switch toggle */
.switch {
  position: relative;
  display: inline-block;
  width: 50px;
  height: 28px;
}
.switch input { 
  opacity: 0;
  width: 0;
  height: 0;
}
.slider {
  position: absolute;
  cursor: pointer;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: #333;
  transition: .4s;
}
.slider:before {
  position: absolute;
  content: "";
  height: 20px;
  width: 20px;
  left: 4px;
  bottom: 4px;
  background-color: white;
  transition: .4s;
}
input:checked + .slider {
  background-color: #8b5cf6; /* purple similar to screenshot */
}
input:focus + .slider {
  box-shadow: 0 0 1px #8b5cf6;
}
input:checked + .slider:before {
  transform: translateX(22px);
}
.slider.round {
  border-radius: 34px;
}
.slider.round:before {
  border-radius: 50%;
}
input:disabled + .slider {
    opacity: 0.5;
    cursor: not-allowed;
}
</style>

<%- include('../partials/tail') %>
