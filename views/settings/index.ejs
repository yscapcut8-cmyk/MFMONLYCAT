<%- include('../partials/head') %>

<div class="card glass-card max-w-2xl mx-auto">
    <div class="card-header">
        <h2>Configurações de Divisão</h2>
        <p class="text-muted">Ajuste as porcentagens para a divisão dos lucros da empresa. A soma deve ser exatamente 100%.</p>
    </div>
    <div class="card-body">
        <form action="/settings" method="POST" class="std-form">
            
            <div class="form-group">
                <label for="company_pct">Fundo da Empresa (%)</label>
                <div class="input-with-icon">
                    <i data-lucide="building"></i>
                    <input type="number" id="company_pct" name="company_pct" step="0.1" min="0" max="100" required 
                           value="<%= settings.company_pct %>">
                </div>
            </div>

            <div class="form-group">
                <label for="ortiz_pct">Parte do Ortiz (%)</label>
                <div class="input-with-icon">
                    <i data-lucide="user"></i>
                    <input type="number" id="ortiz_pct" name="ortiz_pct" step="0.1" min="0" max="100" required 
                           value="<%= settings.ortiz_pct %>">
                </div>
            </div>

            <div class="form-group">
                <label for="davi_pct">Parte do Davi (%)</label>
                <div class="input-with-icon">
                    <i data-lucide="user"></i>
                    <input type="number" id="davi_pct" name="davi_pct" step="0.1" min="0" max="100" required 
                           value="<%= settings.davi_pct %>">
                </div>
            </div>

            <div class="form-actions mt-6">
                <button type="submit" class="btn btn-primary">
                    <i data-lucide="save"></i> Salvar Configurações
                </button>
            </div>
        </form>
    </div>
</div>

<%- include('../partials/tail') %>
