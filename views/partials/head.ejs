<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title : 'MoneyFinance' %></title>
    <meta name="description" content="MoneyFinance — Gestão financeira para sócios">
    <link rel="preconnect" href="https://fonts.bunny.net">
    <link href="https://fonts.bunny.net/css?family=inter:300,400,500,600,700,800" rel="stylesheet" />
    <link rel="stylesheet" href="/css/style.css">
    <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.min.js"></script>
</head>
<body>
<div class="app-container">
    <% if (user) { %>
        <%- include('sidebar') %>
    <% } %>

    <main class="main-content <%= user ? '' : 'no-sidebar' %>">
        <% if (user) { %>
        <header class="topbar">
            <div class="topbar-left">
                <button class="menu-toggle" id="menuToggle">
                    <i data-lucide="menu"></i>
                </button>
                <span class="topbar-title"><%= typeof title !== 'undefined' ? title.split(' - ')[0] : 'MoneyFinance' %></span>
            </div>
            <div class="topbar-right">
                <div class="user-chip-header">
                    <div class="user-chip-avatar-sm"><%= user.name.charAt(0).toUpperCase() %></div>
                    <span class="user-chip-name-sm"><%= user.name %></span>
                    <% if (user.role === 'admin') { %><span class="admin-badge">Admin</span><% } %>
                </div>
                <a href="/logout" class="topbar-logout" title="Sair">
                    <i data-lucide="log-out"></i>
                </a>
            </div>
        </header>
        <% } %>

        <div class="content-wrapper">
            <!-- Global Notifications -->
            <% if (typeof upcomingRenewals !== 'undefined' && upcomingRenewals.length > 0) { %>
                <div class="alert alert-warning" style="margin-bottom: var(--sp-6);">
                    <i data-lucide="alert-triangle"></i>
                    <div>
                        <strong>Aviso de Vencimento:</strong>
                        <% if (upcomingRenewals.length === 1) { %>
                            A ferramenta <b><%= upcomingRenewals[0].name %></b> vence no dia <%= new Date(upcomingRenewals[0].renewal_date).toLocaleDateString('pt-BR') %> (R$ <%= upcomingRenewals[0].amount.toFixed(2) %>).
                        <% } else { %>
                            Existem <%= upcomingRenewals.length %> ferramentas vencendo nos próximos 7 dias.
                        <% } %>
                    </div>
                </div>
            <% } %>

            <% if (typeof error !== 'undefined' && error) { %>
                <div class="alert alert-error">
                    <i data-lucide="alert-circle"></i>
                    <span><%= error %></span>
                </div>
            <% } %>
            <% if (typeof success !== 'undefined' && success) { %>
                <div class="alert alert-success">
                    <i data-lucide="check-circle-2"></i>
                    <span><%= success %></span>
                </div>
            <% } %>
