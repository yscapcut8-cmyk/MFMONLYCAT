<header class="topbar">
    <div class="topbar-left">
        <h1 class="page-title"><%= title %></h1>
    </div>
    <div class="topbar-right">
        <div class="user-profile">
            <div class="avatar">
                <%= user.name.charAt(0).toUpperCase() %>
            </div>
            <span class="user-name"><%= user.name %></span>
        </div>
    </div>
</header>
