<%- include('../partials/head') %>

<div class="section-block">
    <div class="section-label">
        <span class="section-dot dot-purple"></span>
        Calculadora de Porcentagem
    </div>
    <p class="text-muted mb-4" style="margin-top: -0.5rem;">Use para calcular divisões, margens, descontos ou qualquer porcentagem rapidamente.</p>

    <!-- TABS -->
    <div class="calc-tabs" id="calcTabs">
        <button class="calc-tab active" data-tab="basic" onclick="switchTab('basic', this)">
            <i data-lucide="percent" style="width: 16px;"></i>
            Básica
        </button>
        <button class="calc-tab" data-tab="split" onclick="switchTab('split', this)">
            <i data-lucide="git-branch" style="width: 16px;"></i>
            Divisão Societária
        </button>
        <button class="calc-tab" data-tab="margin" onclick="switchTab('margin', this)">
            <i data-lucide="trending-up" style="width: 16px;"></i>
            Margem e Lucro
        </button>
        <button class="calc-tab" data-tab="discount" onclick="switchTab('discount', this)">
            <i data-lucide="tag" style="width: 16px;"></i>
            Desconto
        </button>
    </div>

    <!-- TAB: BÁSICA -->
    <div class="calc-panel active" id="tab-basic">
        <div class="calc-card">
            <div class="calc-grid-2">
                <div>
                    <h4 class="calc-section-title">X% de Y</h4>
                    <div class="form-group">
                        <label>Porcentagem (%)</label>
                        <input type="number" id="b1-pct" placeholder="Ex: 10" oninput="calcBasic1()">
                    </div>
                    <div class="form-group">
                        <label>Valor Total (R$)</label>
                        <input type="number" id="b1-total" placeholder="Ex: 1000" oninput="calcBasic1()">
                    </div>
                    <div class="calc-result" id="b1-result">—</div>
                </div>
                <div>
                    <h4 class="calc-section-title">X é qual % de Y?</h4>
                    <div class="form-group">
                        <label>Valor Parcial (R$)</label>
                        <input type="number" id="b2-part" placeholder="Ex: 150" oninput="calcBasic2()">
                    </div>
                    <div class="form-group">
                        <label>Valor Total (R$)</label>
                        <input type="number" id="b2-total" placeholder="Ex: 1000" oninput="calcBasic2()">
                    </div>
                    <div class="calc-result" id="b2-result">—</div>
                </div>
            </div>
        </div>
    </div>

    <!-- TAB: DIVISÃO SOCIETÁRIA -->
    <div class="calc-panel" id="tab-split">
        <div class="calc-card">
            <div class="form-group">
                <label>Valor a Dividir (R$)</label>
                <input type="number" id="split-total" placeholder="Ex: 5000" oninput="calcSplit()">
            </div>
            <div class="split-partners" id="split-partners">
                <div class="split-partner-row">
                    <input type="text" placeholder="Nome (ex: Ortiz)" class="split-name" oninput="calcSplit()">
                    <input type="number" placeholder="%" class="split-pct" oninput="calcSplit()" min="0" max="100">
                    <div class="split-partner-result">—</div>
                    <button class="btn btn-sm btn-danger-outline" onclick="removePartner(this)" title="Remover">
                        <i data-lucide="trash-2" style="width: 14px;"></i>
                    </button>
                </div>
                <div class="split-partner-row">
                    <input type="text" placeholder="Nome (ex: Davi)" class="split-name" oninput="calcSplit()">
                    <input type="number" placeholder="%" class="split-pct" oninput="calcSplit()" min="0" max="100">
                    <div class="split-partner-result">—</div>
                    <button class="btn btn-sm btn-danger-outline" onclick="removePartner(this)" title="Remover">
                        <i data-lucide="trash-2" style="width: 14px;"></i>
                    </button>
                </div>
            </div>
            <div style="display: flex; align-items: center; gap: 1rem; margin-top: 1rem;">
                <button class="btn btn-outline btn-sm" onclick="addPartner()">
                    <i data-lucide="plus" style="width: 14px;"></i> Adicionar Sócio
                </button>
                <div id="split-sum-warning" class="calc-warning hidden">⚠️ Total não soma 100%</div>
            </div>
        </div>
    </div>

    <!-- TAB: MARGEM -->
    <div class="calc-panel" id="tab-margin">
        <div class="calc-card">
            <div class="calc-grid-2">
                <div>
                    <h4 class="calc-section-title">Calcular Margem de Lucro</h4>
                    <div class="form-group">
                        <label>Custo (R$)</label>
                        <input type="number" id="m-cost" placeholder="Ex: 800" oninput="calcMargin()">
                    </div>
                    <div class="form-group">
                        <label>Preço de Venda (R$)</label>
                        <input type="number" id="m-price" placeholder="Ex: 1000" oninput="calcMargin()">
                    </div>
                    <div class="calc-result" id="m-result">—</div>
                </div>
                <div>
                    <h4 class="calc-section-title">Calcular Preço com Margem</h4>
                    <div class="form-group">
                        <label>Custo (R$)</label>
                        <input type="number" id="mm-cost" placeholder="Ex: 800" oninput="calcMarkup()">
                    </div>
                    <div class="form-group">
                        <label>Margem Desejada (%)</label>
                        <input type="number" id="mm-margin" placeholder="Ex: 30" oninput="calcMarkup()">
                    </div>
                    <div class="calc-result" id="mm-result">—</div>
                </div>
            </div>
        </div>
    </div>

    <!-- TAB: DESCONTO -->
    <div class="calc-panel" id="tab-discount">
        <div class="calc-card">
            <div class="calc-grid-2">
                <div>
                    <h4 class="calc-section-title">Valor com Desconto</h4>
                    <div class="form-group">
                        <label>Preço Original (R$)</label>
                        <input type="number" id="d-price" placeholder="Ex: 1000" oninput="calcDiscount()">
                    </div>
                    <div class="form-group">
                        <label>Desconto (%)</label>
                        <input type="number" id="d-pct" placeholder="Ex: 15" oninput="calcDiscount()">
                    </div>
                    <div class="calc-result" id="d-result">—</div>
                </div>
                <div>
                    <h4 class="calc-section-title">Qual foi o desconto aplicado?</h4>
                    <div class="form-group">
                        <label>Preço Original (R$)</label>
                        <input type="number" id="dr-original" placeholder="Ex: 1000" oninput="calcDiscountReverse()">
                    </div>
                    <div class="form-group">
                        <label>Preço Final (R$)</label>
                        <input type="number" id="dr-final" placeholder="Ex: 850" oninput="calcDiscountReverse()">
                    </div>
                    <div class="calc-result" id="dr-result">—</div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
// Tab switching
function switchTab(tab, btn) {
    document.querySelectorAll('.calc-panel').forEach(p => p.classList.remove('active'));
    document.querySelectorAll('.calc-tab').forEach(t => t.classList.remove('active'));
    document.getElementById('tab-' + tab).classList.add('active');
    btn.classList.add('active');
    lucide.createIcons();
}

function fmt(n) {
    if (isNaN(n) || !isFinite(n)) return '—';
    return 'R$ ' + n.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
}
function fmtPct(n) {
    if (isNaN(n) || !isFinite(n)) return '—';
    return n.toFixed(2) + '%';
}

// BÁSICA
function calcBasic1() {
    const pct = parseFloat(document.getElementById('b1-pct').value);
    const total = parseFloat(document.getElementById('b1-total').value);
    const res = (pct / 100) * total;
    const el = document.getElementById('b1-result');
    el.innerHTML = isNaN(res) ? '—' : `<span class="result-label">${fmtPct(pct)} de ${fmt(total)} =</span><span class="result-value">${fmt(res)}</span>`;
}
function calcBasic2() {
    const part = parseFloat(document.getElementById('b2-part').value);
    const total = parseFloat(document.getElementById('b2-total').value);
    const res = (part / total) * 100;
    const el = document.getElementById('b2-result');
    el.innerHTML = isNaN(res) ? '—' : `<span class="result-label">${fmt(part)} de ${fmt(total)} =</span><span class="result-value">${fmtPct(res)}</span>`;
}

// DIVISÃO
function addPartner() {
    const container = document.getElementById('split-partners');
    const row = document.createElement('div');
    row.className = 'split-partner-row';
    row.innerHTML = `
        <input type="text" placeholder="Nome" class="split-name" oninput="calcSplit()">
        <input type="number" placeholder="%" class="split-pct" oninput="calcSplit()" min="0" max="100">
        <div class="split-partner-result">—</div>
        <button class="btn btn-sm btn-danger-outline" onclick="removePartner(this)" title="Remover">
            <i data-lucide="trash-2" style="width: 14px;"></i>
        </button>`;
    container.appendChild(row);
    lucide.createIcons();
}
function removePartner(btn) {
    const rows = document.querySelectorAll('.split-partner-row');
    if (rows.length <= 1) return;
    btn.closest('.split-partner-row').remove();
    calcSplit();
}
function calcSplit() {
    const total = parseFloat(document.getElementById('split-total').value) || 0;
    const rows = document.querySelectorAll('.split-partner-row');
    let sum = 0;
    rows.forEach(row => {
        const pct = parseFloat(row.querySelector('.split-pct').value) || 0;
        const name = row.querySelector('.split-name').value || 'Sócio';
        const val = total * (pct / 100);
        const res = row.querySelector('.split-partner-result');
        sum += pct;
        res.innerHTML = isNaN(val) || total === 0 ? '—' : `<span class="result-label">${name} (${pct}%):</span><span class="result-value">${fmt(val)}</span>`;
    });
    const warn = document.getElementById('split-sum-warning');
    if (sum !== 0 && Math.abs(sum - 100) > 0.01) {
        warn.classList.remove('hidden');
        warn.textContent = `⚠️ Total: ${sum.toFixed(1)}% (faltam ${(100 - sum).toFixed(1)}%)`;
    } else {
        warn.classList.add('hidden');
    }
}

// MARGEM
function calcMargin() {
    const cost = parseFloat(document.getElementById('m-cost').value);
    const price = parseFloat(document.getElementById('m-price').value);
    const profit = price - cost;
    const margin = (profit / price) * 100;
    const el = document.getElementById('m-result');
    if (isNaN(margin)) { el.innerHTML = '—'; return; }
    el.innerHTML = `<span class="result-label">Lucro: ${fmt(profit)} | Margem:</span><span class="result-value ${margin >= 0 ? 'text-success' : 'text-danger'}">${fmtPct(margin)}</span>`;
}
function calcMarkup() {
    const cost = parseFloat(document.getElementById('mm-cost').value);
    const margin = parseFloat(document.getElementById('mm-margin').value);
    const price = cost / (1 - margin / 100);
    const el = document.getElementById('mm-result');
    if (isNaN(price) || !isFinite(price)) { el.innerHTML = '—'; return; }
    el.innerHTML = `<span class="result-label">Preço de Venda sugerido:</span><span class="result-value">${fmt(price)}</span>`;
}

// DESCONTO
function calcDiscount() {
    const price = parseFloat(document.getElementById('d-price').value);
    const pct = parseFloat(document.getElementById('d-pct').value);
    const disc = price * (pct / 100);
    const final = price - disc;
    const el = document.getElementById('d-result');
    if (isNaN(final)) { el.innerHTML = '—'; return; }
    el.innerHTML = `<span class="result-label">Desconto: ${fmt(disc)} | Preço final:</span><span class="result-value text-success">${fmt(final)}</span>`;
}
function calcDiscountReverse() {
    const original = parseFloat(document.getElementById('dr-original').value);
    const final = parseFloat(document.getElementById('dr-final').value);
    const pct = ((original - final) / original) * 100;
    const el = document.getElementById('dr-result');
    if (isNaN(pct)) { el.innerHTML = '—'; return; }
    el.innerHTML = `<span class="result-label">Desconto aplicado:</span><span class="result-value text-danger">${fmtPct(pct)}</span>`;
}
</script>

<%- include('../partials/tail') %>
