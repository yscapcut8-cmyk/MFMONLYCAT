<%- include('partials/head') %>

<!-- 1. VISÃO GERAL -->
<div class="section-block">
    <div class="section-label">
        <span class="section-dot dot-green"></span>
        Visão Geral do Negócio
    </div>
    <div class="dashboard-grid dashboard-grid-3" style="grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));">
        <div class="kpi-card kpi-income">
            <div class="kpi-icon">
                <i data-lucide="arrow-up-right"></i>
            </div>
            <div class="kpi-body">
                <span class="kpi-label">Faturamento Total</span>
                <span class="kpi-value">R$ <%= faturamento.toLocaleString('pt-BR', { minimumFractionDigits: 2 }) %></span>
            </div>
        </div>

        <div class="kpi-card" style="border-left: 3px solid var(--info); background: rgba(59, 130, 246, 0.04);">
            <div class="kpi-icon" style="background: rgba(59,130,246,0.1); color: var(--info);">
                <i data-lucide="activity"></i>
            </div>
            <div class="kpi-body" style="position: relative; width: 100%;">
                <div style="display: flex; justify-content: space-between; align-items: center; width: 100%;">
                    <span class="kpi-label" id="webhook-label">Faturamento Hoje</span>
                    <select id="webhook-period" onchange="updateWebhookMetrics()" style="background: rgba(0,0,0,0.2); border: 1px solid rgba(255,255,255,0.1); color: var(--text-muted); border-radius: 4px; font-size: 0.75rem; padding: 2px 5px; outline: none; cursor: pointer;">
                        <option value="hoje" style="background: #111;">Hoje</option>
                        <option value="ontem" style="background: #111;">Ontem</option>
                        <option value="7dias" style="background: #111;">7 Dias</option>
                        <option value="30dias" style="background: #111;">30 Dias</option>
                        <option value="total" style="background: #111;">Total</option>
                    </select>
                </div>
                <span class="kpi-value" id="webhook-value">R$ <%= typeof faturamentoHoje !== 'undefined' ? faturamentoHoje.toLocaleString('pt-BR', { minimumFractionDigits: 2 }) : '0,00' %></span>
                <span class="kpi-sub text-info" style="font-size: 0.7rem;">Automático via Webhook</span>
            </div>
        </div>

        <div class="kpi-card kpi-expense">
            <div class="kpi-icon">
                <i data-lucide="arrow-down-left"></i>
            </div>
            <div class="kpi-body">
                <span class="kpi-label">Custos Operacionais</span>
                <span class="kpi-value">R$ <%= custosGerais.toLocaleString('pt-BR', { minimumFractionDigits: 2 }) %></span>
                <% if (expensePercent > 0) { %>
                    <span class="kpi-sub"><%= expensePercent %>% do faturamento</span>
                <% } %>
            </div>
        </div>

        <div class="kpi-card kpi-profit">
            <div class="kpi-icon kpi-icon-primary">
                <i data-lucide="zap"></i>
            </div>
            <div class="kpi-body">
                <span class="kpi-label">Lucro Líquido a Dividir</span>
                <span class="kpi-value text-glow">R$ <%= lucroADividir.toLocaleString('pt-BR', { minimumFractionDigits: 2 }) %></span>
            </div>
        </div>
    </div>
</div>

<!-- 2. DIVISÃO SOCIETÁRIA -->
<div class="section-block">
    <div class="section-label">
        <span class="section-dot dot-blue"></span>
        Divisão Societária — baseado no Lucro Líquido
    </div>
    <div class="dashboard-grid dashboard-grid-2">
        <div class="kpi-card partner-card">
            <div class="partner-avatar">O</div>
            <div class="kpi-body">
                <span class="kpi-label">Parte do Ortiz (<%= settings.ortiz_pct %>%)</span>
                <span class="kpi-value">R$ <%= ortizShare.toLocaleString('pt-BR', { minimumFractionDigits: 2 }) %></span>
            </div>
        </div>

        <div class="kpi-card partner-card">
            <div class="partner-avatar">D</div>
            <div class="kpi-body">
                <span class="kpi-label">Parte do Davi (<%= settings.davi_pct %>%)</span>
                <span class="kpi-value">R$ <%= daviShare.toLocaleString('pt-BR', { minimumFractionDigits: 2 }) %></span>
            </div>
        </div>
    </div>
</div>

<!-- 3. CAIXA DA EMPRESA -->
<div class="section-block">
    <div class="section-label">
        <span class="section-dot dot-red"></span>
        Caixa da Empresa (<%= settings.company_pct %>% do Lucro)
    </div>
    <div class="dashboard-grid dashboard-grid-2">
        <div class="kpi-card kpi-expense">
            <div class="kpi-icon">
                <i data-lucide="wrench"></i>
            </div>
            <div class="kpi-body">
                <span class="kpi-label">Gastos em Ferramentas / Retiradas</span>
                <span class="kpi-value">- R$ <%= companyFerramentas.toLocaleString('pt-BR', { minimumFractionDigits: 2 }) %></span>
                <% if (companyAportes > 0) { %>
                    <span class="kpi-sub text-success">+ R$ <%= companyAportes.toLocaleString('pt-BR', { minimumFractionDigits: 2 }) %> em aportes</span>
                <% } %>
            </div>
        </div>

        <div class="kpi-card kpi-company <%= companyRealBalance >= 0 ? '' : 'kpi-negative' %>">
            <div class="kpi-icon kpi-icon-primary">
                <i data-lucide="building-2"></i>
            </div>
            <div class="kpi-body">
                <span class="kpi-label">Saldo Real da Empresa</span>
                <span class="kpi-value <%= companyRealBalance >= 0 ? 'text-primary' : 'text-danger' %>">
                    R$ <%= companyRealBalance.toLocaleString('pt-BR', { minimumFractionDigits: 2 }) %>
                </span>
                <a href="/company" class="kpi-link" style="display: block; margin-top: 10px;">Gerenciar caixa e ferramentas →</a>
            </div>
        </div>
    </div>
</div>

<!-- 4. ÚLTIMAS TRANSAÇÕES -->
<div class="section-block">
    <div class="card glass-card">
        <div class="card-header flex-between">
            <div class="section-label" style="margin-bottom:0;">
                <span class="section-dot dot-purple"></span>
                Últimas Transações
            </div>
            <a href="/transactions" class="btn btn-sm btn-outline">Ver todas</a>
        </div>
        <div class="card-body">
            <% if (recentTransactions.length > 0) { %>
                <table class="table">
                    <thead>
                        <tr>
                            <th>Data</th>
                            <th>Descrição</th>
                            <th>Por</th>
                            <th>Tipo</th>
                            <th>Valor</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% recentTransactions.forEach(t => { %>
                            <tr>
                                <td class="text-muted"><%= new Date(t.date).toLocaleDateString('pt-BR') %></td>
                                <td><strong><%= t.description %></strong></td>
                                <td><span class="badge badge-outline"><%= t.user_name %></span></td>
                                <td>
                                    <% if (t.type === 'income') { %>
                                        <span class="badge badge-success">Entrada</span>
                                    <% } else { %>
                                        <span class="badge badge-danger">Saída</span>
                                    <% } %>
                                </td>
                                <td class="<%= t.type === 'income' ? 'text-success' : 'text-danger' %>" style="font-weight: 600;">
                                    <%= t.type === 'income' ? '+' : '-' %> R$ <%= t.amount.toLocaleString('pt-BR', { minimumFractionDigits: 2 }) %>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            <% } else { %>
                <div class="empty-state">
                    <i data-lucide="inbox"></i>
                    <p>Nenhuma transação registrada ainda.</p>
                </div>
            <% } %>
        </div>
    </div>
</div>

<script>
    const webhookData = {
        'hoje': { label: 'Faturamento Hoje', value: <%= typeof faturamentoHoje !== 'undefined' ? faturamentoHoje : 0 %> },
        'ontem': { label: 'Faturamento Ontem', value: <%= typeof faturamentoOntem !== 'undefined' ? faturamentoOntem : 0 %> },
        '7dias': { label: 'Faturamento 7 Dias', value: <%= typeof faturamento7Dias !== 'undefined' ? faturamento7Dias : 0 %> },
        '30dias': { label: 'Faturamento 30 Dias', value: <%= typeof faturamento30Dias !== 'undefined' ? faturamento30Dias : 0 %> },
        'total': { label: 'Faturamento Total (Automático)', value: <%= typeof faturamento !== 'undefined' ? faturamento : 0 %> }
    };

    function updateWebhookMetrics() {
        const period = document.getElementById('webhook-period').value;
        const data = webhookData[period];
        document.getElementById('webhook-label').innerText = data.label;
        document.getElementById('webhook-value').innerText = 'R$ ' + data.value.toLocaleString('pt-BR', { minimumFractionDigits: 2 });
    }
</script>

<%- include('partials/tail') %>
